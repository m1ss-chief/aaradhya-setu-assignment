# Local MongoDB (e.g. `docker compose up -d` from the project root):
MONGODB_URI=mongodb://127.0.0.1:27017
# Or MongoDB Atlas (free tier):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aaradhya_setu

# Optional: Shopify webhook signing secret. When set, /api/webhooks/shopify/orders-create
# rejects requests whose X-Shopify-Hmac-Sha256 header does not match.
SHOPIFY_WEBHOOK_SECRET=

# Signs the admin session cookie. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The admin login `npm run seed` creates (or resets). Add more logins with:
#   npm run create-admin -- <admin-id> <password> "<Full name>"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Setu@2026
ADMIN_NAME=Setu Admin

# Optional: shows these demo credentials on the sign-in page (leave empty in production).
DEMO_LOGIN_HINT=admin / Setu@2026

# Optional: share of mock WhatsApp sends that fail at random (0 to 1), to rehearse "Resend".
# Malformed numbers always fail, whatever this is set to.
MOCK_WHATSAPP_FAILURE_RATE=0
